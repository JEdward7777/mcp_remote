/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

/sw.js
  Cache-Control: no-cache

/dl/mcp-remote.json
  Cache-Control: no-cache

/dl/*.tgz
  Cache-Control: public, max-age=31536000, immutable
