{
  "name": "mcp-remote-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "worker",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w worker && npm run build -w mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "vapid": "node worker/scripts/vapid.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  }
}
